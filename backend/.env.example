# Copy to backend/.env for local development. Placeholder values only — never commit real secrets.
VX_ENVIRONMENT=development
VX_DATABASE_URL=postgresql+psycopg://vittasynx:CHANGE_ME@localhost:5432/vittasynx
# Use a separate, more privileged role for migrations in staging/production:
# VX_MIGRATION_DATABASE_URL=postgresql+psycopg://vittasynx_migrator:CHANGE_ME@localhost:5432/vittasynx
VX_COOKIE_SECURE=false
VX_REQUIRE_MFA_FOR_PRIVILEGED=true
VX_FILE_STORAGE_DIR=./var/files
VX_APP_BASE_URL=http://localhost:3000
VX_EMAIL_BACKEND=dev_outbox
